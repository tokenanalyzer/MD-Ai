# Backend runtime configuration. Copy to services/backend/.env for local dev.
# NEVER commit a real .env file. NEVER put a provider API key here — the
# backend holds no provider keys at all. Keys live in the Android app's
# Keystore-backed local vault and are sent transiently, per request, for
# in-memory use only (see docs/architecture/07-security-model.md §3).

NODE_ENV=development
PORT=8080

DATABASE_URL=postgres://mdai:mdai@localhost:5432/mdai
REDIS_URL=redis://localhost:6379

# Signing secret for device session JWTs. Generate locally
# (e.g. `openssl rand -base64 32`), never reuse across environments.
MDAI_JWT_SECRET=

# Single-use device pairing code TTL, in minutes.
MDAI_PAIRING_CODE_TTL_MINUTES=10

# Firebase Cloud Messaging (push notifications), added in M5.
FCM_SERVICE_ACCOUNT_JSON=
