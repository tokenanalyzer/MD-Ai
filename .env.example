# Backend runtime configuration. Copy to services/backend/.env for local dev.
# NEVER commit a real .env file. NEVER put a provider API key here — the
# backend holds no provider keys at all. Keys live in the Android app's
# Keystore-backed local vault and are sent transiently, per request, for
# in-memory use only (see docs/architecture/07-security-model.md §3).

NODE_ENV=development
PORT=8080

DATABASE_URL=postgres://mdai:mdai@localhost:5432/mdai
REDIS_URL=redis://localhost:6379

# Signing secret for device session JWTs. Generate locally
# (e.g. `openssl rand -base64 32`), never reuse across environments.
MDAI_JWT_SECRET=

# Single-use device pairing code TTL, in minutes.
MDAI_PAIRING_CODE_TTL_MINUTES=10

# Push notifications (added in M5) go through Expo's push service, not a
# directly-configured FCM service account — nothing to set here for push.

# M5.12a: key-encrypting key for the opt-in background credential vault
# (core/security/backgroundKeyVault.ts) — base64-encoded, exactly 32 bytes
# decoded (e.g. `openssl rand -base64 32`). Only required if the owner opts
# a provider into background use (bot escalation, automations) from the
# phone; absent by default, bots keep running deterministically either way.
MDAI_BACKGROUND_KEY_KEK=

# M10: comma-separated external MCP server URLs to connect at boot (e.g.
# OpenClaw once a real endpoint exists) — optional, the app is fully usable
# without it.
MDAI_EXTERNAL_MCP_SERVERS=
