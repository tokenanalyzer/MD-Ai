# Backend runtime configuration. Copy to services/backend/.env for local dev.
# NEVER commit a real .env file. NEVER put a provider API key here — those
# are entered by the user at runtime through the Vault UI and stored
# encrypted in Postgres (see docs/architecture/07-security-model.md).

NODE_ENV=development
PORT=8080

DATABASE_URL=postgres://mdai:mdai@localhost:5432/mdai
REDIS_URL=redis://localhost:6379

# Key Encryption Key source for the provider credential vault.
# Local dev: a generated 32-byte base64 value. Production: sourced from
# Oracle Cloud Vault, never checked in.
MDAI_KEK=

# Signing secret for device session JWTs.
MDAI_JWT_SECRET=

# Firebase Cloud Messaging (push notifications), added in M5.
FCM_SERVICE_ACCOUNT_JSON=
