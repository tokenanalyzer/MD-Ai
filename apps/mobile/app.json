{
  "expo": {
    "name": "MD AI",
    "slug": "md-ai",
    "scheme": "mdai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1a1a1a",
    "icon": "./assets/logo.png",
    "platforms": ["android", "web"],
    "android": {
      "package": "com.venom31.mdai",
      "backgroundColor": "#1a1a1a",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#1a1a1a"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#1a1a1a",
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "mdaiBackendUrl": "https://md-ai.onrender.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8291b9a2-89be-47be-a39b-86e4b22e314c"
      }
    }
  }
}
